{
  "name": "@searchcraft/client",
  "version": "0.3.0",
  "description": "TypeScript client library for the Searchcraft API",
  "type": "module",
  "keywords": [
    "searchcraft",
    "search",
    "api-client",
    "typescript",
    "full-text-search",
    "sdk",
    "search-engine",
    "federated-search",
    "query-builder"
  ],
  "author": "Searchcraft",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/searchcraft-inc/searchcraft-client-js.git"
  },
  "bugs": {
    "url": "https://github.com/searchcraft-inc/searchcraft-issues"
  },
  "homepage": "https://github.com/searchcraft-inc/searchcraft-client-js",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "biome:migrate": "biome migrate --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
